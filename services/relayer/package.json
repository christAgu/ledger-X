{
  "name": "ledgerx-relayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "e2e": "npm run build && bash scripts/e2e.sh"
  },
  "dependencies": {
    "@cosmjs/encoding": "0.34.1",
    "@cosmjs/proto-signing": "0.34.1",
    "@cosmjs/stargate": "0.34.1",
    "@cosmjs/tendermint-rpc": "0.34.1",
    "cosmjs-types": "0.9.0",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "eslint": "8.57.1",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
